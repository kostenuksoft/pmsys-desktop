<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="40">
			<StackPanel Spacing="10">
				<ComboBox PlaceholderText="Select an option">
					<ComboBoxItem>Option 1</ComboBoxItem>
					<ComboBoxItem>Option 2</ComboBoxItem>
					<ComboBoxItem>Option 3</ComboBoxItem>
				</ComboBox>
				<ComboBox SelectedIndex="0">
					<ComboBoxItem>Selected Item</ComboBoxItem>
					<ComboBoxItem>Another Item</ComboBoxItem>
				</ComboBox>
				<ComboBox IsEnabled="False" PlaceholderText="Disabled ComboBox"/>
				<ComboBox Classes="accent" PlaceholderText="Accent ComboBox">
					<ComboBoxItem>Accent Option 1</ComboBoxItem>
					<ComboBoxItem>Accent Option 2</ComboBoxItem>
				</ComboBox>
			</StackPanel>
		</Border>
	</Design.PreviewWith>

	<!-- Default ComboBox Style -->
	<Style Selector="ComboBox">
		<Setter Property="Background" Value="#FBFBFB"/>
		<Setter Property="BorderBrush" Value="#D1D1D1"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="Foreground" Value="#000000"/>
		<Setter Property="Padding" Value="11,5,11,6"/>
		<Setter Property="MinHeight" Value="32"/>
		<Setter Property="FontFamily" Value="Segoe UI Variable"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="VerticalAlignment" Value="Center"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Name="Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
					<Border.Transitions>
						<Transitions>
							<BrushTransition Property="Background" Duration="0:0:0.15"/>
							<BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
						</Transitions>
					</Border.Transitions>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="32"/>
						</Grid.ColumnDefinitions>

						<ContentPresenter Name="ContentPresenter"
                                        Grid.Column="0"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding ItemTemplate}"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"/>

						<TextBlock Name="PlaceholderTextBlock"
                                 Grid.Column="0"
                                 Text="{TemplateBinding PlaceholderText}"
                                 Foreground="#999999"
                                 Margin="{TemplateBinding Padding}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 IsVisible="False"/>

						<Border Grid.Column="1"
                                Width="32"
                                Background="Transparent">
							<Path Name="DropDownArrow"
                                  Fill="#606060"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Width="8"
                                  Height="4"
                                  Stretch="Fill"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
								<Path.Transitions>
									<Transitions>
										<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
									</Transitions>
								</Path.Transitions>
							</Path>
						</Border>

						<Popup Grid.Column="0" Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                               MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                               MaxHeight="300"
                               PlacementTarget="Background"
                               IsLightDismissEnabled="True">
							<Border Background="#FFFFFF"
                                    BorderBrush="#D1D1D1"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,2,0,0">
								<Border.Effect>
									<DropShadowEffect Color="#40000000"
                                                    OffsetX="0"
                                                    OffsetY="4"
                                                    BlurRadius="16"/>
								</Border.Effect>
								<ScrollViewer>
									<ItemsPresenter Name="PART_ItemsPresenter"
                                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                                  Margin="2"/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Placeholder Visibility -->
	<Style Selector="ComboBox /template/ TextBlock#PlaceholderTextBlock">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
	<Style Selector="ComboBox:empty /template/ TextBlock#PlaceholderTextBlock">
		<Setter Property="IsVisible" Value="True"/>
	</Style>

	<!-- Hover State -->
	<Style Selector="ComboBox:pointerover /template/ Border#Background">
		<Setter Property="Background">
			<RadialGradientBrush Center="50%,50%">
				<GradientStop Color="#F0F8F8" Offset="0"/>
				<GradientStop Color="#E8F4F4" Offset="0.7"/>
				<GradientStop Color="#E0F0F0" Offset="1"/>
			</RadialGradientBrush>
		</Setter>
		<Setter Property="BorderBrush" Value="#5F9EA0"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#305F9EA0" OffsetX="0" OffsetY="2" BlurRadius="8"/>
		</Setter>
	</Style>

	<Style Selector="ComboBox:pointerover /template/ Path#DropDownArrow">
		<Setter Property="Fill" Value="#5F9EA0"/>
	</Style>

	<!-- Pressed/Open State -->
	<Style Selector="ComboBox:pressed /template/ Border#Background,
                     ComboBox:dropdownopen /template/ Border#Background">
		<Setter Property="Background">
			<RadialGradientBrush Center="50%,50%">
				<GradientStop Color="#D8E8E8" Offset="0"/>
				<GradientStop Color="#CCE0E0" Offset="0.5"/>
				<GradientStop Color="#C0D8D8" Offset="1"/>
			</RadialGradientBrush>
		</Setter>
		<Setter Property="BorderBrush" Value="#2F4F4F"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#402F4F4F" OffsetX="0" OffsetY="1" BlurRadius="4"/>
		</Setter>
	</Style>

	<!-- Focus State -->
	<Style Selector="ComboBox:focus /template/ Border#Background">
		<Setter Property="BorderBrush" Value="#5F9EA0"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#405F9EA0" OffsetX="0" OffsetY="0" BlurRadius="4"/>
		</Setter>
	</Style>

	<Style Selector="ComboBox:focus-visible /template/ Border#Background">
		<Setter Property="BorderBrush" Value="#5F9EA0"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#605F9EA0" OffsetX="0" OffsetY="0" BlurRadius="6"/>
		</Setter>
	</Style>

	<!-- Invalid State -->
	<Style Selector="ComboBox:invalid /template/ Border#Background">
		<Setter Property="BorderBrush" Value="#D13438"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>

	<Style Selector="ComboBox:invalid:focus /template/ Border#Background">
		<Setter Property="BorderBrush" Value="#D13438"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#60D13438" OffsetX="0" OffsetY="0" BlurRadius="6"/>
		</Setter>
	</Style>

	<!-- Empty with Focus (placeholder visible) -->
	<Style Selector="ComboBox:empty:focus /template/ TextBlock#PlaceholderTextBlock">
		<Setter Property="Foreground" Value="#5F9EA0"/>
	</Style>

	<!-- Rotate arrow when dropdown is open -->
	<Style Selector="ComboBox:dropdownopen /template/ Path#DropDownArrow">
		<Setter Property="RenderTransform">
			<RotateTransform Angle="180"/>
		</Setter>
		<Setter Property="Fill" Value="#2F4F4F"/>
	</Style>

	<!-- Disabled State -->
	<Style Selector="ComboBox:disabled /template/ Border#Background">
		<Setter Property="Background" Value="#F9F9F9"/>
		<Setter Property="BorderBrush" Value="#E0E0E0"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#20000000" OffsetX="0" OffsetY="1" BlurRadius="2"/>
		</Setter>
	</Style>

	<Style Selector="ComboBox:disabled">
		<Setter Property="Foreground" Value="#A6A6A6"/>
	</Style>

	<Style Selector="ComboBox:disabled /template/ Path#DropDownArrow">
		<Setter Property="Fill" Value="#A6A6A6"/>
	</Style>

	<Style Selector="ComboBox:disabled /template/ TextBlock#PlaceholderTextBlock">
		<Setter Property="Foreground" Value="#A6A6A6"/>
	</Style>

	<!-- ComboBoxItem Base Style -->
	<Style Selector="ComboBox ComboBoxItem">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#000000"/>
		<Setter Property="Padding" Value="11,6,11,6"/>
		<Setter Property="MinHeight" Value="32"/>
		<Setter Property="FontFamily" Value="Segoe UI Variable"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="CornerRadius" Value="2"/>
		<Setter Property="Margin" Value="2,1"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
					<Border.Transitions>
						<Transitions>
							<BrushTransition Property="Background" Duration="0:0:0.1"/>
						</Transitions>
					</Border.Transitions>
					<ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    TextBlock.Foreground="{TemplateBinding Foreground}"/>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- ComboBoxItem Hover -->
	<Style Selector="ComboBox ComboBoxItem:pointerover">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
				<GradientStop Color="#F0F8F8" Offset="0"/>
				<GradientStop Color="#E8F4F4" Offset="0.5"/>
				<GradientStop Color="#F0F8F8" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
	</Style>

	<!-- ComboBoxItem Selected -->
	<Style Selector="ComboBox ComboBoxItem:selected">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#E8F4F4" Offset="0"/>
				<GradientStop Color="#D8E8E8" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
	</Style>

	<!-- ComboBoxItem Pressed -->
	<Style Selector="ComboBox ComboBoxItem:pressed">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#CCE0E0" Offset="0"/>
				<GradientStop Color="#C0D8D8" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
	</Style>

	<!-- ComboBoxItem Focus -->
	<Style Selector="ComboBox ComboBoxItem:focus">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
				<GradientStop Color="#E0F0F0" Offset="0"/>
				<GradientStop Color="#D8E8E8" Offset="0.5"/>
				<GradientStop Color="#E0F0F0" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
		<Setter Property="BorderBrush" Value="#5F9EA0"/>
		<Setter Property="BorderThickness" Value="0.5"/>
	</Style>

	<!-- ComboBoxItem Disabled -->
	<Style Selector="ComboBox ComboBoxItem:disabled">
		<Setter Property="Foreground" Value="#A6A6A6"/>
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<!-- ComboBoxItem Selected + Hover -->
	<Style Selector="ComboBox ComboBoxItem:selected:hover">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#CCE0E0" Offset="0"/>
				<GradientStop Color="#C0D8D8" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
	</Style>

	<!-- Dropdown Open + Hover -->
	<Style Selector="ComboBox:dropdownopen:hover /template/ Border#Background">
		<Setter Property="Background">
			<RadialGradientBrush Center="50%,50%">
				<GradientStop Color="#CCE0E0" Offset="0"/>
				<GradientStop Color="#C0D8D8" Offset="0.5"/>
				<GradientStop Color="#B8D0D0" Offset="1"/>
			</RadialGradientBrush>
		</Setter>
	</Style>

	<!-- ========================================
	     ACCENT COMBOBOX VARIANT
	     ======================================== -->

	<Style Selector="ComboBox.accent">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#3A5F5F" Offset="0"/>
				<GradientStop Color="#2F4F4F" Offset="0.5"/>
				<GradientStop Color="#284848" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
		<Setter Property="BorderBrush" Value="#4A6F6F"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="6"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="Padding" Value="11,5,11,6"/>
		<Setter Property="MinHeight" Value="32"/>
		<Setter Property="FontFamily" Value="Segoe UI Variable"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Border Name="Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
					<Border.Effect>
						<DropShadowEffect Color="#403A5F5F" OffsetX="0" OffsetY="2" BlurRadius="8"/>
					</Border.Effect>
					<Border.Transitions>
						<Transitions>
							<BrushTransition Property="Background" Duration="0:0:0.15"/>
							<BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
						</Transitions>
					</Border.Transitions>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="32"/>
						</Grid.ColumnDefinitions>

						<ContentPresenter Name="ContentPresenter"
                                        Grid.Column="0"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding ItemTemplate}"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"/>

						<TextBlock Name="PlaceholderTextBlock"
                                 Grid.Column="0"
                                 Text="{TemplateBinding PlaceholderText}"
                                 Foreground="#8FA5A5"
                                 Margin="{TemplateBinding Padding}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 IsVisible="False"/>

						<Border Grid.Column="1"
                                Width="32"
                                Background="Transparent">
							<Path Name="DropDownArrow"
                                  Fill="#FFFFFF"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Width="8"
                                  Height="4"
                                  Stretch="Fill"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
								<Path.Transitions>
									<Transitions>
										<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
									</Transitions>
								</Path.Transitions>
							</Path>
						</Border>

						<Popup Grid.Column="0" Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                               MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                               MaxHeight="300"
                               PlacementTarget="Background"
                               IsLightDismissEnabled="True">
							<Border Background="#2F4F4F"
                                    BorderBrush="#4A6F6F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,2,0,0">
								<Border.Effect>
									<DropShadowEffect Color="#60000000"
                                                    OffsetX="0"
                                                    OffsetY="4"
                                                    BlurRadius="16"/>
								</Border.Effect>
								<ScrollViewer>
									<ItemsPresenter Name="PART_ItemsPresenter"
                                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                                  Margin="2"/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Accent Placeholder Visibility -->
	<Style Selector="ComboBox.accent /template/ TextBlock#PlaceholderTextBlock">
		<Setter Property="IsVisible" Value="False"/>
	</Style>
	<Style Selector="ComboBox.accent:empty /template/ TextBlock#PlaceholderTextBlock">
		<Setter Property="IsVisible" Value="True"/>
	</Style>

	<!-- Accent Hover -->
	<Style Selector="ComboBox.accent:pointerover /template/ Border#Background">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#4A7A7A" Offset="0"/>
				<GradientStop Color="#3A6A6A" Offset="0.5"/>
				<GradientStop Color="#305A5A" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
		<Setter Property="BorderBrush" Value="#5F8F8F"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#504A7A7A" OffsetX="0" OffsetY="3" BlurRadius="12"/>
		</Setter>
	</Style>

	<!-- Accent Pressed/Open -->
	<Style Selector="ComboBox.accent:pressed /template/ Border#Background,
                     ComboBox.accent:dropdownopen /template/ Border#Background">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#253333" Offset="0"/>
				<GradientStop Color="#1F2D2D" Offset="0.5"/>
				<GradientStop Color="#1A2828" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
		<Setter Property="BorderBrush" Value="#2A4444"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#60253333" OffsetX="0" OffsetY="1" BlurRadius="8"/>
		</Setter>
	</Style>

	<!-- Accent Focus -->
	<Style Selector="ComboBox.accent:focus /template/ Border#Background">
		<Setter Property="BorderBrush" Value="#5F8F8F"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#605F8F8F" OffsetX="0" OffsetY="0" BlurRadius="6"/>
		</Setter>
	</Style>

	<!-- Accent Empty with Focus -->
	<Style Selector="ComboBox.accent:empty:focus /template/ TextBlock#PlaceholderTextBlock">
		<Setter Property="Foreground" Value="#B8CACA"/>
	</Style>

	<!-- Accent Arrow Rotation -->
	<Style Selector="ComboBox.accent:dropdownopen /template/ Path#DropDownArrow">
		<Setter Property="RenderTransform">
			<RotateTransform Angle="180"/>
		</Setter>
	</Style>

	<!-- Accent Disabled -->
	<Style Selector="ComboBox.accent:disabled /template/ Border#Background">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#D8E5E5" Offset="0"/>
				<GradientStop Color="#CDD9D9" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
		<Setter Property="BorderBrush" Value="#B8CACA"/>
		<Setter Property="Effect">
			<DropShadowEffect Color="#20506060" OffsetX="0" OffsetY="1" BlurRadius="3"/>
		</Setter>
	</Style>

	<Style Selector="ComboBox.accent:disabled">
		<Setter Property="Foreground" Value="#8FA5A5"/>
	</Style>

	<Style Selector="ComboBox.accent:disabled /template/ Path#DropDownArrow">
		<Setter Property="Fill" Value="#8FA5A5"/>
	</Style>

	<Style Selector="ComboBox.accent:disabled /template/ TextBlock#PlaceholderTextBlock">
		<Setter Property="Foreground" Value="#8FA5A5"/>
	</Style>

	<!-- Accent ComboBoxItem Base -->
	<Style Selector="ComboBox.accent ComboBoxItem">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#FFFFFF"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<!-- Accent ComboBoxItem Hover -->
	<Style Selector="ComboBox.accent ComboBoxItem:pointerover">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
				<GradientStop Color="#3A6A6A" Offset="0"/>
				<GradientStop Color="#4A7A7A" Offset="0.5"/>
				<GradientStop Color="#3A6A6A" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
	</Style>

	<!-- Accent ComboBoxItem Selected -->
	<Style Selector="ComboBox.accent ComboBoxItem:selected">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#4A7A7A" Offset="0"/>
				<GradientStop Color="#3A6A6A" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
	</Style>

	<!-- Accent ComboBoxItem Pressed -->
	<Style Selector="ComboBox.accent ComboBoxItem:pressed">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#253333" Offset="0"/>
				<GradientStop Color="#1F2D2D" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
	</Style>

	<!-- Accent ComboBoxItem Focus -->
	<Style Selector="ComboBox.accent ComboBoxItem:focus">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
				<GradientStop Color="#305A5A" Offset="0"/>
				<GradientStop Color="#3A6A6A" Offset="0.5"/>
				<GradientStop Color="#305A5A" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
		<Setter Property="BorderBrush" Value="#5F8F8F"/>
		<Setter Property="BorderThickness" Value="0.5"/>
	</Style>

	<!-- Accent ComboBoxItem Disabled -->
	<Style Selector="ComboBox.accent ComboBoxItem:disabled">
		<Setter Property="Foreground" Value="#8FA5A5"/>
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<!-- Accent ComboBoxItem Selected + Hover -->
	<Style Selector="ComboBox.accent ComboBoxItem:selected:hover">
		<Setter Property="Background">
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#305A5A" Offset="0"/>
				<GradientStop Color="#284848" Offset="1"/>
			</LinearGradientBrush>
		</Setter>
	</Style>

</Styles>