<windowing:AppWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:vm="clr-namespace:PMS.ViewModels"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                     x:Class="PMS.Views.Window.LoginWindow"
                     CanResize="False"
                     MaxWidth="500"
                     SizeToContent="Height"
                     WindowStartupLocation="CenterScreen"
                     x:DataType="vm:LoginViewModel"
                     KeyDown="OnKeyDown"
                     SystemDecorations="Full">

    <Window.Styles>

        <Style Selector="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Height" Value="45" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="ToggleButton.primary">
            <Setter Property="Height" Value="45" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="AliceBlue" Offset="12" />
        </LinearGradientBrush>
    </Window.Background>

    <DockPanel Background="DarkSlateGray">

        <Grid DockPanel.Dock="Top"
              Height="40"
              Background="DarkSlateGray"
              Name="CustomTitleBar"
              ColumnDefinitions="Auto,*,Auto,138">

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0" Spacing="10">

                <Viewbox Width="25">
                    <Image Source="avares://PMS/Assets/Ico/keyauth.ico" />
                </Viewbox>

                <TextBlock Text="{Binding WindowTitle.Value}"
                           Foreground="AliceBlue"
                           FontWeight="SemiBold"
                           Padding="0,5"
                           FontSize="{DynamicResource FontSizeLarge}" />
            </StackPanel>


            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="5,0">

            </StackPanel>
        </Grid>


        <Border Background="#FDFDFD"
                CornerRadius="5"
                BoxShadow="0 2 10 0 #40000000"
                Margin="25, 10, 25,25"
                Padding="50">

            <Grid RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,15"
                            Orientation="Vertical">

                    <Viewbox Width="50" HorizontalAlignment="Left">
                        <controls:IconSourceElement IconSource="Permissions" />
                    </Viewbox>

                    <TextBlock Text="{Binding LoginHeader.Value}"
                               FontWeight="SemiBold"
                               FontSize="22"
                               Foreground="#666666"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,0" />

                    <Separator />
                    <controls:InfoBar x:Name="NotificationBar"
                                      Title="{Binding Title}"
                                      Message="{Binding Message}"
                                      Severity="{Binding MessageSeverity}"
                                      IsVisible="{Binding IsInfoBarVisible}"
                                      IsOpen="True"
                                      IsClosable="False"
                                      Margin="0, 25, 0, 0">
                        <controls:InfoBar.ActionButton>
                            <Button Content="{Binding ChangePasswordButton.Value}"
                                    IsVisible="{Binding ForgotPasswordVisible}"
                                    Command="{Binding ChangePasswordCommand}"
                                    Classes="WButton"
                                    HorizontalAlignment="Right" />
                        </controls:InfoBar.ActionButton>
                    </controls:InfoBar>
                </StackPanel>

                <StackPanel Grid.Row="1">


                    <TextBox Name="UsernameBox"
                             Text="{Binding Username}"
                             VerticalContentAlignment="Center"
                             Tag="{Binding UsernameWatermark.Value}"
                             Margin="0,0,0,15">
                    </TextBox>

                    <Grid>
                        <Grid ColumnDefinitions="*"
                              ColumnSpacing="5">

							<TextBox Text="{Binding Password}"
                                     IsVisible="{Binding ShowPassword}"
                                     VerticalContentAlignment="Center"
                                     ClearSelectionOnLostFocus="True"
                                     Tag="{Binding PasswordWatermark.Value}"
                                     ContextFlyout="{x:Null}" />

                            <TextBox Name="PasswordBox"
                                     Text="{Binding Password}"
                                     PasswordChar="•"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,0"
                                     IsVisible="{Binding !ShowPassword}"
                                     Tag="{Binding PasswordWatermark.Value}"
                                     ContextFlyout="{x:Null}" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <ToggleButton Name="RememberMeCheck"
                                              IsChecked="{Binding RememberMe}"
                                              IsEnabled="True"
                                              Classes="primary"
                                              Width="30"
                                              Height="30"
                                              Margin="0, 0">

                                    <StackPanel>
                                        <ToolTip.Tip>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding RememberMeTooltip.Value}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToolTip.Tip>


                                        <Viewbox Width="30" Height="20">
                                            <controls:IconSourceElement IconSource="SaveLocal" />
                                        </Viewbox>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton Name="ShowPasswordCheck"
                                              HorizontalAlignment="Right"
                                              FontSize="13"
                                              IsChecked="{Binding ShowPassword}"
                                              Width="30"
                                              Height="30"
                                              Classes="primary"
                                              Margin="5, 0">

                                    <Viewbox Width="30" Height="20">
                                        <controls:IconSourceElement IconSource="View" />
                                    </Viewbox>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Orientation="Vertical"
                                Margin="0,15,0,0"
                                Spacing="5">

                        <HyperlinkButton Name="ForgotPasswordBtn"
                                         Content="{Binding ForgotPasswordLink.Value}"
                                         Command="{Binding ForgotPasswordCommand}"
                                         Foreground="DarkSlateGray"
                                         BorderBrush="Transparent"
                                         Classes="WButton"
                                         HorizontalAlignment="Left"
                                         Padding="0"
                                         Cursor="Hand" />
                    </StackPanel>

                    <Separator Margin="0, 20" Background="#DFDFDF" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="5"
                                HorizontalAlignment="Right">

                        <Button Name="CloseBtn"
                                Content="{Binding BackButton.Value}"
                                Click="OnClose"
                                Classes="primary WButton accent"
                                Height="35"
                                Width="80"
                                HorizontalAlignment="Center"
                                Margin="0,0, 0,0" />

                        <Button Name="LoginBtn"
                                Content="{Binding LoginButton.Value}"
                                Command="{Binding LoginCommand}"
                                Classes="primary WButton"
                                Height="35"
                                Click="SubmitButton_Click"
                                Width="80"
                                HorizontalAlignment="Center"
                                Margin="0,0, 0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</windowing:AppWindow>