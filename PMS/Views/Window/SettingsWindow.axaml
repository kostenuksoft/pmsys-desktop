<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PMS.Views.Window.SettingsWindow"
        Title="{Binding WindowTitle.Value}"
        Width="950"
        Height="800"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        xmlns:vm="clr-namespace:PMS.ViewModels"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:general="clr-namespace:PMS.Core.Enums.General"
        x:CompileBindings="True"
        x:DataType="vm:SettingsViewModel">

    <Window.Styles>
        <Style Selector="Border.SectionCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="DarkSlateGray" />
        </Style>

		<Style Selector="TextBlock.SectionDescription">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="160" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style Selector="controls|NumberBox">
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Height" Value="32" />
            <Setter Property="SpinButtonPlacementMode" Value="Inline" />
        </Style>


        <Style Selector="ToggleSwitch">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


        <Style Selector="TextBlock.UnitLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="ToggleButton.primary">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

    </Window.Styles>


    <DockPanel>

        <Grid DockPanel.Dock="Top"
              Height="40"
              Name="CustomTitleBar" 
              ColumnDefinitions="Auto,*,Auto,138">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#764ba2" Offset="0"/>
                    <GradientStop Color="DarkSlateGray" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel></StackPanel>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0" Spacing="10">

                <Viewbox Width="25">
                    <Image Source="avares://PMS/Assets/al.ico" />
                </Viewbox>

                <TextBlock Text="PMS"
                           Foreground="AliceBlue"
                           FontWeight="SemiBold"
                           Padding="0,5"
                           FontSize="{DynamicResource FontSizeLarge}" />
            </StackPanel>


            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="5,0">
            </StackPanel>
        </Grid>

        <Grid RowDefinitions="Auto,*,Auto">

			<Border Grid.Row="0"
                    BoxShadow="0 2 8 0 #20000000"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">

				<StackPanel Margin="32,24">

                    <Rectangle Height="3"
                               Fill="DarkSlateGray"
                               HorizontalAlignment="Left"
                               Width="80"
                               Margin="0,0,0,20" />

                    <TextBlock Text="{Binding ConfigTitle.Value}"
                               FontSize="32"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ConfigDescription.Value}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               LineHeight="22" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="16,16"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Expander IsExpanded="True" ExpandDirection="Right">
                        <Expander.Header>
                            <Grid Margin="0,2,0,0"
                                  ColumnDefinitions="Auto, Auto, *"
                                  VerticalAlignment="Center"
                                  ColumnSpacing="10">

                                <Viewbox Width="50">
                                    <controls:IconSourceElement IconSource="Account" />
                                </Viewbox>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding AuthTitle.Value}"
                                               Classes="SectionTitle"
                                               Margin="0,10,0,0"/>
                                    <Separator/>
                                    <TextBlock Text="{Binding AuthDescription.Value}"
                                               Classes="SectionDescription" />
                                </StackPanel>

                                <WrapPanel Grid.Column="2"
                                           VerticalAlignment="Center">
                                    <Button Content="{Binding AuthLoginButton.Value}"
                                            Command="{Binding ShowLoginWindowCommand}"
                                            Margin="10,0,0,0"
                                            Classes="WButton"/>
                                </WrapPanel>

                            </Grid>
                        </Expander.Header>
                        <Separator/>
                    </Expander>

                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <Grid Margin="0,2,0,0" 
                                  ColumnDefinitions="Auto, Auto, *"
                                  VerticalAlignment="Center"
                                  ColumnSpacing="10">


								<Viewbox Width="50">
                                    <controls:IconSourceElement IconSource="Code" />
                                </Viewbox>


								<StackPanel Grid.Column="1">

                                    <TextBlock Text="{Binding DatabaseSectionTitle.Value}"
                                               Classes="SectionTitle" 
                                               Margin="0,10, 0, 0"/>
                                    <Separator/>
                                    <TextBlock Text="{Binding DatabaseSectionDescription.Value}"
                                               Classes="SectionDescription" />

                                </StackPanel>

                                <StackPanel Grid.Column="2" 
                                            Spacing="10"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <Button Command="{Binding SaveCommand}"
                                            CommandParameter="{x:Static general:SettingsGroup.Database}"
                                            Classes="WButton "
                                            Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="SaveLocal"/>
                                        </Viewbox>
									</Button>
                                    <Button
                                            Command="{Binding DeleteCommand}"
                                            CommandParameter="{x:Static general:SettingsGroup.Database}"
                                            Classes="WButton"
                                            Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="Delete"/>
                                        </Viewbox>
									</Button>

									<ToggleButton
                                            Command="{Binding SetDefaultCommand}"
                                            CommandParameter="{x:Static general:SettingsGroup.Database}"
                                            Classes="primary WButton"
                                            Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="Refresh"/>
                                        </Viewbox>
									</ToggleButton>
								</StackPanel>

							</Grid>
                        </Expander.Header>

                        <Border Classes="SectionCard">

                            <StackPanel>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="Auto,*,Auto"
                                      RowSpacing="12"
                                      ColumnSpacing="16">

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding HostLabel.Value}"
                                               Classes="FieldLabel" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding Host}"
                                             Tag="localhost" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding PortLabel.Value}"
                                               Classes="FieldLabel" />
                                    <controls:NumberBox Grid.Row="1" Grid.Column="1"
                                                        Value="{Binding Port}"
                                                        Minimum="1"
                                                        Maximum="65535" />

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="{Binding DatabaseNameLabel.Value}"
                                               Classes="FieldLabel" />
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding DatabaseName}"
                                             Tag="" />

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="{Binding AuthenticationTitle.Value}"
                                               Classes="FieldLabel" />
                                    <ToggleSwitch Grid.Row="3" Grid.Column="1"
                                                  IsChecked="{Binding UseAuthentication}"
                                                  HorizontalAlignment="Left" />
                                </Grid>

                                <Border IsVisible="{Binding UseAuthentication}"
                                        Margin="0,16,0,0">
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="Auto,*,Auto"
                                          RowSpacing="12"
                                          ColumnSpacing="16">

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding UsernameLabel.Value}"
                                                   Classes="FieldLabel" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding Username}"
                                                 Tag="{Binding UsernamePlaceholder.Value}" />


                                        <TextBlock
                                            Grid.Row="1" Grid.Column="0" Text="{Binding PasswordLabel.Value}"
                                            Classes="FieldLabel" />

                                        <TextBox
                                            Grid.Row="1" Grid.Column="1" Text="{Binding Password}"
                                            PasswordChar="{Binding PasswordChar}"
                                            Tag="{Binding PasswordPlaceholder.Value}"
                                            Margin="0, 0, 35, 0" />

                                        <ToggleButton Grid.Row="1" Grid.Column="1" Name="ShowPasswordCheck"
                                                      HorizontalContentAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      FontSize="16"
                                                      IsChecked="{Binding ShowPassword}"
                                                      Width="30"
                                                      Classes="primary"
                                                      Height="30"
                                                      CornerRadius="5"
                                                      Margin="0,0,0,0">
                                            <Viewbox Width="20">
                                                <controls:IconSourceElement IconSource="View" />
                                            </Viewbox>
                                        </ToggleButton>

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{Binding AuthDatabaseLabel.Value}"
                                                   Classes="FieldLabel" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding AuthDatabase}"
                                                 Tag="..." />
                                    </Grid>
                                </Border>

                                <Separator Margin="0,20" />
                                <TextBlock Text="{Binding OtherSettingsTitle.Value}"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,12" />

                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="Auto,*,Auto"
                                      RowSpacing="12"
                                      ColumnSpacing="16">

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ConnectionTimeoutLabel.Value}"
                                               Classes="FieldLabel" />
                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <controls:NumberBox Value="{Binding ConnectionTimeout}"
                                                            Minimum="1"
                                                            Maximum="300"
                                                            MinWidth="100" />
                                        <TextBlock Text="{Binding SecondsLabel.Value}"
                                                   Classes="UnitLabel" />
                                    </StackPanel>

                                </Grid>
                            </StackPanel>
                        </Border>

                    </Expander>

					<Expander IsExpanded="False">
						<Expander.Header >
                            <Grid Margin="0,2,0,0"
                                  ColumnDefinitions="Auto, Auto, *"
                                  VerticalAlignment="Center"
                                  ColumnSpacing="10">
								<Viewbox Width="45">
									<controls:IconSourceElement IconSource="Edit" />
								</Viewbox>

								<StackPanel Grid.Column="1">
									<TextBlock Text="{Binding LoggingSectionTitle.Value}"
                                               Classes="SectionTitle"
                                               Margin="0,10,0,0"/>
                                    <Separator/>
									<TextBlock Text="{Binding LoggingSectionDescription.Value}"
                                               Classes="SectionDescription" />

								</StackPanel>

                                <StackPanel Grid.Column="2"
                                            Spacing="10"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
									<Button Command="{Binding SaveCommand}"
                                            CommandParameter="{x:Static general:SettingsGroup.Logging}"
                                            Classes="WButton "
                                            Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="SaveLocal"/>
                                        </Viewbox>
                                    </Button>
                                    <Button
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{x:Static general:SettingsGroup.Logging}"
                                        Classes="WButton"
                                        Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="Delete"/>
                                        </Viewbox>
                                    </Button>
									<ToggleButton
                                        Command="{Binding SetDefaultCommand}"
                                        CommandParameter="{x:Static general:SettingsGroup.Logging}"
                                        Classes="primary WButton"
                                        Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="Refresh"/>
                                        </Viewbox>
                                    </ToggleButton>
                                </StackPanel>
							</Grid>

						</Expander.Header>
						<Border Classes="SectionCard">
							<StackPanel>
								<Grid RowDefinitions="Auto,Auto,Auto"
									  ColumnDefinitions="Auto,*,Auto"
									  RowSpacing="12"
									  ColumnSpacing="16">

									<!-- Log File Path -->
									<TextBlock Grid.Row="0" Grid.Column="0"
											   Text="{Binding LogFilePathLabel.Value}"
											   Classes="FieldLabel" />
									<TextBox Grid.Row="0" Grid.Column="1"
											 Text="{Binding LogFilePath}"
											 Tag="Logs/PMS-{Date}.log" />
									<Button Grid.Row="0" Grid.Column="2"
											Classes="WButton"
											Command="{Binding BrowseLogPathCommand}">
										<Button.Content>
											<controls:IconSourceElement IconSource="Folder" />
										</Button.Content>

									</Button>

									<!-- Rolling Interval -->
									<TextBlock Grid.Row="1" Grid.Column="0"
											   Text="{Binding RollingIntervalLabel.Value}"
											   Classes="FieldLabel" />
                                    <controls:FAComboBox Grid.Row="1" Grid.Column="1"
                                                         SelectedItem="{Binding RollingIntervalDay}"
                                                         ItemsSource="{Binding RollingIntervalsCollection}"
                                                         DisplayMemberBinding="{Binding Value}"
                                                         HorizontalAlignment="Left">
                                    </controls:FAComboBox>

									<!-- Retained Files -->
									<TextBlock Grid.Row="2" Grid.Column="0"
											   Text="{Binding RetainedFilesLabel.Value}"
											   Classes="FieldLabel" />
									<StackPanel Grid.Row="2" Grid.Column="1"
												Orientation="Horizontal"
												Spacing="8">
										<controls:NumberBox Value="{Binding RetainedFileCountLimit}"
															Minimum="1"
															Maximum="365"
															MinWidth="100" />
										<TextBlock Text="{Binding FilesLabel.Value}"
												   Classes="UnitLabel" />
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>
					</Expander>

					<Expander IsExpanded="False">
                        <Expander.Header>
							<Grid Margin="0,2,0,0"
                                  ColumnDefinitions="Auto, Auto, *"
                                  VerticalAlignment="Center"
                                  ColumnSpacing="10">
                                <Viewbox Width="50">
                                    <controls:IconSourceElement IconSource="Settings" />
                                </Viewbox>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ApplicationSectionTitle.Value}"
                                               Classes="SectionTitle" 
                                               Margin="0,10,0,0"/>
                                    <Separator/>
                                    <TextBlock Text="{Binding ApplicationSectionDescription.Value}"
                                               Classes="SectionDescription" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Spacing="10"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
									<Button Command="{Binding SaveCommand}"
                                            CommandParameter="{x:Static general:SettingsGroup.Application}"
                                            Classes="WButton "
                                            Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="SaveLocal"/>
                                        </Viewbox>
                                    </Button>
                                    <Button
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{x:Static general:SettingsGroup.Application}"
                                        Classes="WButton"
                                        Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="Delete"/>
                                        </Viewbox>
                                    </Button>
									<ToggleButton
                                        Command="{Binding SetDefaultCommand}"
                                        CommandParameter="{x:Static general:SettingsGroup.Application}"
                                        Classes="primary WButton"
                                        Padding="10,5">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="Refresh"/>
                                        </Viewbox>
                                    </ToggleButton>
                                </StackPanel>

                            </Grid>
                        </Expander.Header>
                    <Border Classes="SectionCard">
                        <StackPanel>
                            <!-- Localization Settings -->
                            <TextBlock Text="{Binding LocalizationTitle.Value}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <Grid RowDefinitions="Auto"
                                  ColumnDefinitions="Auto,*"
                                  RowSpacing="12"
                                  ColumnSpacing="16"
                                  Margin="0,0,0,20">

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding DefaultLanguageLabel.Value}"
                                           Classes="FieldLabel" />
                                <controls:FAComboBox
                                    Grid.Row="0" 
                                    Grid.Column="1"
                                    SelectedItem="{Binding SelectedDefaultLanguage}"
                                    ItemsSource="{Binding AvailableLanguages}"
                                    DisplayMemberBinding="{Binding DisplayName}"
                                    HorizontalAlignment="Left">

                                    <Interaction.Behaviors>
                                        <EventTriggerBehavior EventName="SelectionChanged">
                                            <InvokeCommandAction Command="{Binding ChangeLanguageCommand }" />
                                        </EventTriggerBehavior>
                                    </Interaction.Behaviors>
								</controls:FAComboBox>

							</Grid>

                            <!-- Data Management Settings -->
                            <Separator Margin="0,8,0,16" />
                            <TextBlock Text="{Binding DataManagementTitle.Value}"
                                       FontWeight="Medium"
                                       Margin="0,0,0,12" />

                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="Auto,*"
                                  RowSpacing="12"
                                  ColumnSpacing="16">

                                <!-- Page Size -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding PageSizeLabel.Value}"
                                           Classes="FieldLabel" />
                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <controls:NumberBox Value="{Binding PageSize}"
                                                        Minimum="10"
                                                        Maximum="500"
                                                        MinWidth="100" />
                                    <TextBlock Text="{Binding RecordsLabel.Value}"
                                               Classes="UnitLabel" />
                                </StackPanel>

                                <!-- Max Export Rows -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding MaxExportRowsLabel.Value}"
                                           Classes="FieldLabel" />
                                <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <controls:NumberBox Value="{Binding MaxExportRows}"
                                                        Minimum="100"
                                                        Maximum="100000"
                                                        MinWidth="100" />
                                    <TextBlock Text="{Binding RecordsLabel.Value}"
                                               Classes="UnitLabel" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </Expander>

				</StackPanel>
			</ScrollViewer>

            <Grid Grid.Row="2"
                  RowDefinitions="Auto,Auto"
                  Background="Transparent">

                <controls:InfoBar Grid.Row="0"
                                  Title="{Binding Title}"
                                  Message="{Binding Message}"
                                  Severity="{Binding MessageSeverity}"
                                  Background="#FDFDFD"
                                  IsOpen="{Binding IsInfoBarVisible}"
                                  IsClosable="True"
                                  ZIndex="1"
                                  Closed="InfoBar_OnClosed"
                                  Margin="16,0,16,8">
                    <controls:InfoBar.ActionButton>
                   
                    </controls:InfoBar.ActionButton>
                </controls:InfoBar>

                <Button Grid.Row="0"  
                        Margin="16,0,16,16" 
                        Classes="WButton"
                        Command="{Binding CollapseInfoBarCommand}"
                        IsVisible="{Binding !IsInfoBarVisible}">
					<Viewbox Width="20">
                        <controls:FontIcon  Glyph="&#xE946;" FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                    </Viewbox>
                </Button>

                <!-- Action Buttons -->
                <Border Grid.Row="1"
                        Background="DarkSlateGray"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="18,10">
                    <Grid ColumnDefinitions="*,Auto">

                
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="12">

							<Button Content="{Binding ExitButtonLabel.Value}"
                                    Command="{Binding ExitCommand}"
                                    IsVisible="{Binding IsStandaloneMode}"
                                    Padding="20,8"
                                    Classes="WButton" />

                            <Button Command="{Binding CancelCommand}"
                                    IsVisible="{Binding IsDialogMode}"
                                    Padding="20,8"
                                    Classes="WButton">
                                        <Viewbox Width="20">
                                            <controls:IconSourceElement IconSource="Back"/>
										</Viewbox>
									</Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12">

                            <Button Content="{Binding TestConnectionButtonLabel.Value}"
                                    Command="{Binding TestConnectionCommand}"
                                    Classes="WButton"
                                    Padding="20,8" />

                            <Button Content="{Binding ContinueButtonLabel.Value}"
                                    Command="{Binding ContinueCommand}"
                                    IsVisible="{Binding IsStandaloneMode}"
                                    Classes="WButton"
                                    IsEnabled="{Binding CanContinue}"
                                    Padding="20,8" />

                       
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>