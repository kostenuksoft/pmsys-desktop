<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="clr-namespace:PMS.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
             x:Class="PMS.Views.Controls.Dialogs.AboutDialogView"
			 x:DataType="dialogs:AboutInfoViewModel"
             x:CompileBindings="True">

	<Grid RowDefinitions="Auto,Auto,Auto">
		<!-- Header with Logo -->
		<Border Grid.Row="0"
                Background="DarkSlateGray"
                Height="25">
			<Grid>
				<Image Source="{Binding Logo}"
                      Width="80"
                      Height="80"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
			</Grid>
		</Border>

		<!-- Content -->
		<DockPanel Grid.Row="1">
				<TextBlock Text="{Binding AppName}"
                          Theme="{StaticResource TitleTextBlockStyle}"
                          HorizontalAlignment="Center"/>

				<TextBlock Text="{Binding Version}"
                          Foreground="{DynamicResource TextFillColorSecondary}"
                          HorizontalAlignment="Center"/>

				<TextBlock Text="{Binding Description}"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Margin="0,10"/>

				<Border BorderBrush="{DynamicResource CardStrokeColorDefault}"
                       BorderThickness="0,1,0,0"
                       Padding="0,15,0,0">
					<StackPanel Spacing="10">
					</StackPanel>
				</Border>

				<!-- Additional Info -->
				<ItemsControl ItemsSource="{Binding AdditionalInfo}"
                             IsVisible="{Binding AdditionalInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid ColumnDefinitions="Auto,*" Margin="0,2">
								<TextBlock Grid.Column="0"
                                          Text="{Binding Key}"
                                          FontWeight="SemiBold"
                                          Margin="0,0,10,0"/>
								<TextBlock Grid.Column="1"
                                          Text="{Binding Value}"
                                          TextWrapping="Wrap"/>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
		</DockPanel>

		<!-- Footer -->
		<Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
		</Border>
	</Grid>
</UserControl>