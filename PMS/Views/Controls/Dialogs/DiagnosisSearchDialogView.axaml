<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:PMS.ViewModels.Dialogs"
             x:Class="PMS.Views.Controls.Dialogs.DiagnosisSearchDialogView"
             x:DataType="vm:DiagnosisSearchDialogViewModel"
             MinWidth="500"
             MaxHeight="500"
             x:CompileBindings="True">

    <StackPanel Spacing="12">

        <!-- Search Box -->
        <StackPanel Spacing="6">
            <TextBlock Text="Пошук діагнозу"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Введіть код МКХ-10 або назву діагнозу..."
                         Height="36">
                    <TextBox.InnerLeftContent>
                        <ui:SymbolIcon Symbol="Find" FontSize="16" Margin="8,0,0,0" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Grid.Column="2"
                        Content="Шукати"
                        Command="{Binding SearchCommand}"
                        Height="36"
                        MinWidth="80" />
            </Grid>
            <TextBlock Text=" Введіть мінімум 2 символи для пошуку"
                       FontSize="10"
                       FontStyle="Italic"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- Search Progress -->
        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4"
                Padding="12"
                IsVisible="{Binding IsSearching}"
                Height="60">
            <StackPanel Orientation="Horizontal"
                       Spacing="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <ui:ProgressRing Width="20" Foreground="DarkSlateGray"
                                Height="20"
                                IsIndeterminate="True" />
                <TextBlock Text="Пошук..."
                          VerticalAlignment="Center"
                          FontSize="13" />
            </StackPanel>
        </Border>

        <!-- No Results Message -->
        <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                CornerRadius="4"
                Padding="12"
                IsVisible="{Binding NoResults}"
                Height="60">
            <StackPanel Orientation="Horizontal"
                       Spacing="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Important"
                              FontSize="16"
                              Foreground="DarkSlateGray" />
                <TextBlock Text="Діагнозів не знайдено"
                          VerticalAlignment="Center"
                          FontSize="13" />
            </StackPanel>
        </Border>

        <!-- Results List -->
        <Border BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                CornerRadius="4"
                ClipToBounds="True"
                IsVisible="{Binding HasResults}">
            <ScrollViewer MaxHeight="300"
                         VerticalScrollBarVisibility="Auto">
                <ListBox ItemsSource="{Binding SearchResults}"
                        SelectedItem="{Binding SelectedDiagnosis}"
                        Background="Transparent"
                        BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8">
                                <Grid RowDefinitions="Auto,Auto"
                                     ColumnDefinitions="*,Auto">

                                    <!-- Diagnosis Name -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                              Text="{Binding Name}"
                                              FontWeight="Medium"
                                              FontSize="13"/>

                                    <!-- ICD Code Badge -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                           Background="DarkSlateGray"
                                           CornerRadius="3"
                                           Padding="6,2"
                                           VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IcdCode}"
                                                  FontSize="10"
                                                  FontWeight="SemiBold"
                                                  Foreground="White"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Instructions -->
        <TextBlock Text="Виберіть діагноз зі списку та натисніть 'Вибрати'"
                   FontSize="11"
                   FontStyle="Italic"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   TextAlignment="Center"
                   IsVisible="{Binding HasResults}" />

    </StackPanel>
</UserControl>
