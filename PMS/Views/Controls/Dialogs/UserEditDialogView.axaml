<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:PMS.ViewModels.Dialogs"
             x:Class="PMS.Views.Controls.Dialogs.UserEditDialogView"
             x:DataType="vm:UserEditDialogViewModel"
             MinWidth="500"
             x:CompileBindings="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,0,0,20">

            <!-- Account Information -->
            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Облікові дані"
                               FontWeight="SemiBold"
                               FontSize="14" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Логін *"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding Login}"
                                 Watermark="username"
                                 MaxLength="50"
                                 IsReadOnly="{Binding IsEditMode}" />
                        <TextBlock Text=" Логін не може бути змінений після створення"
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   IsVisible="{Binding IsEditMode}" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding !IsEditMode}">
                        <TextBlock Text="Пароль *"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding Password}"
                                 Watermark="Введіть пароль..."
                                 PasswordChar="●"
                                 MaxLength="100" />
                        <TextBlock Text=" Мінімум 6 символів"
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="ПІБ *"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding FullName}"
                                 Watermark="Іванов Іван Іванович"
                                 MaxLength="200" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Контактна інформація"
                               FontWeight="SemiBold"
                               FontSize="14" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Email"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding Email}"
                                 Watermark="user@example.com"
                                 MaxLength="100" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Телефон"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding Phone}"
                                 Watermark="+380501234567"
                                 MaxLength="20" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Роль та права доступу"
                               FontWeight="SemiBold"
                               FontSize="14" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Роль *"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox SelectedIndex="{Binding SelectedRoleIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Гість" />
                            <ComboBoxItem Content="Авторизований" />
                            <ComboBoxItem Content="Оператор" />
                            <ComboBoxItem Content="Адміністратор" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Права доступу"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <CheckBox IsChecked="{Binding ViewData}"
                                  Content=" Перегляд даних" />

                        <CheckBox IsChecked="{Binding EditData}"
                                  Content=" Редагування даних" />

                        <CheckBox IsChecked="{Binding DeleteData}"
                                  Content=" Видалення даних" />

                        <CheckBox IsChecked="{Binding RunAggregations}"
                                  Content=" Запуск агрегацій" />

                        <CheckBox IsChecked="{Binding SaveResults}"
                                  Content=" Збереження результатів" />

                        <CheckBox IsChecked="{Binding ManageUsers}"
                                  Content=" Управління користувачами" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <CheckBox IsChecked="{Binding IsActive}"
                      Content=" Активний користувач"
                      Margin="0,8,0,0" />

            <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    CornerRadius="4"
                    Padding="12,8">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="*" FontWeight="Bold" />
                    <Run Text="— обов'язкові поля для заповнення" />
                </TextBlock>
            </Border>

            <ItemsControl ItemsSource="{Binding ValidationContext.Validations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8,6"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:SymbolIcon Symbol="Important"
                                               FontSize="14"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{Binding  }"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
