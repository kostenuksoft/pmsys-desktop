<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:PMS.ViewModels"
             xmlns:general="clr-namespace:PMS.Core.Enums.General"
             x:Class="PMS.Views.Controls.ProceduresView"
             x:DataType="vm:ProcedureViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Search & Filters -->
        <Grid Grid.Row="0" RowDefinitions="Auto, Auto">
            <!-- Search Box -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center">
                <ui:SymbolIcon
                    Symbol="Find"
                    FontSize="25"
                    Margin="10, 0"
                    VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Watermark="Пошук за назвою, кодом або описом..."
                         Foreground="Black"
                         MinWidth="500"
                         MaxWidth="500"
                         Text="{Binding SearchText}"
                         Margin="0,10,0,12">
                </TextBox>
            </Grid>

            <!-- Filters -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">

                <!-- Procedure Type Filter -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Тип процедури" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="220"
                              SelectedValue="{Binding FilterProcedureType}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Всі типи" Tag="{x:Null}" />
                        <ComboBoxItem Content="Діагностична">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>Diagnostic</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Терапевтична">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>Therapeutic</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Фізіотерапія">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>PhysicalTherapy</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Лабораторна">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>Laboratory</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Візуалізація">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>Imaging</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Вакцинація">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>Vaccination</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Профілактична">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>Preventive</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Реабілітація">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>Rehabilitation</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Невідкладна">
                            <ComboBoxItem.Tag>
                                <general:ProcedureType>Emergency</general:ProcedureType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Статус" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="130"
                              SelectedValue="{Binding FilterIsActive}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Всі" Tag="{x:Null}" />
                        <ComboBoxItem Content="Активні">
                            <ComboBoxItem.Tag>
                                <x:Boolean>True</x:Boolean>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Неактивні">
                            <ComboBoxItem.Tag>
                                <x:Boolean>False</x:Boolean>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto">

            <ui:CommandBar DefaultLabelPosition="Right"
                           Margin="8">
                <ui:CommandBar.PrimaryCommands>
                    <ui:CommandBarButton
                        Label="Нова процедура"
                        Command="{Binding AddProcedureCommand}"
                        IconSource="Add" />

                    <ui:CommandBarButton 
                        Label="Редагувати"
                        Command="{Binding EditProcedureCommand}"
                        CommandParameter="{Binding SelectedProcedure}"
                        IconSource="Edit"
                        IsEnabled="{Binding SelectedProcedure, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <ui:CommandBarButton 
                        Label="Видалити"
                        Command="{Binding DeleteProcedureCommand}"
                        CommandParameter="{Binding SelectedProcedure}"
                        IconSource="Delete"
                        IsEnabled="{Binding SelectedProcedure, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <ui:CommandBarSeparator />
                    <ui:CommandBarButton
                        Label="Оновити"
                        Command="{Binding RefreshCommand}"
                        IconSource="Refresh" />
                </ui:CommandBar.PrimaryCommands>
            </ui:CommandBar>

            <!-- Clear Filters Button -->
            <Button Grid.Column="1"
                    Command="{Binding ClearFiltersCommand}"
                    VerticalAlignment="Center"
                    Margin="0,8,8,8"
                    ToolTip.Tip="Очистити всі фільтри">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Clear" FontSize="14" />
                    <TextBlock Text="Очистити фільтри" FontSize="12" />
                </StackPanel>
            </Button>

            <!-- Pagination with First/Last -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Margin="0,8,25,8">

                <!-- First Page -->
                <Button Command="{Binding FirstPageCommand}"
                        Padding="8,5"
                        MinWidth="32"
                        ToolTip.Tip="Перша сторінка">
                    <ui:SymbolIcon Symbol="Previous" FontSize="12" />
                </Button>

                <!-- Previous Page -->
                <Button Command="{Binding PreviousPageCommand}"
                        Padding="8,5"
                        MinWidth="32"
                        ToolTip.Tip="Попередня сторінка">
                    <ui:SymbolIcon Symbol="ChevronLeft" FontSize="12" />
                </Button>

                <!-- Page Info -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="10,5"
                        MinWidth="60"
                        VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               HorizontalAlignment="Center">
                        <Run Text="{Binding CurrentPage}" FontWeight="SemiBold" />
                        <Run Text="/" />
                        <Run Text="{Binding TotalPages}" />
                    </TextBlock>
                </Border>

                <!-- Next Page -->
                <Button Command="{Binding NextPageCommand}"
                        Padding="8,5"
                        MinWidth="32"
                        ToolTip.Tip="Наступна сторінка">
                    <ui:SymbolIcon Symbol="ChevronRight" FontSize="12" />
                </Button>

                <!-- Last Page -->
                <Button Command="{Binding LastPageCommand}"
                        Padding="8,5"
                        MinWidth="32"
                        ToolTip.Tip="Остання сторінка">
                    <ui:SymbolIcon Symbol="Next" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content - DataGrid -->
        <Grid Grid.Row="2" Margin="8,0,8,8">

            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    CornerRadius="4"
                    ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Procedures}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectedProcedure}">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Код"
                                            Binding="{Binding ProcedureCode}"
                                            Width="Auto"
                                            MinWidth="100" />

                        <DataGridTextColumn Header="Назва процедури"
                                            Binding="{Binding Name}"
                                            Width="Auto"
                                            MinWidth="200" />

                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding ProcedureTypeDisplay}"
                                            Width="Auto"
                                            MinWidth="150" />

                        <DataGridTextColumn Header="Тривалість"
                                            Binding="{Binding DurationDisplay}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Ціна"
                                            Binding="{Binding PriceDisplay}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Потрібен лікар"
                                            Binding="{Binding RequiresDoctorDisplay}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding StatusDisplay}"
                                            Width="Auto" />

                    </DataGrid.Columns>

                    <!-- Context Menu -->
                    <DataGrid.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="Редагувати"
                                      Command="{Binding EditProcedureCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Edit" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Видалити"
                                      Command="{Binding DeleteProcedureCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </DataGrid.ContextFlyout>

                </DataGrid>
            </Border>

        </Grid>

        <!-- Statistics Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                CornerRadius="4"
                Padding="12,8"
                Margin="8,0,8,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Statistics -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="Document" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="Всього процедур:" />
                            <Run Text="{Binding TotalItems}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <Border Width="1" Height="16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="Accept" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="На сторінці:" />
                            <Run Text="{Binding Procedures.Count}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Busy Indicator -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding IsBusy}"
                            VerticalAlignment="Center">
                    <ui:ProgressRing Width="16"
                                     Height="16"
                                     IsIndeterminate="True" />
                    <TextBlock Text="{Binding BusyMessage}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- InfoBar -->
        <Grid Grid.Row="4" Margin="8,0,8,8">
            <ui:InfoBar Title="{Binding Title}"
                        Message="{Binding Message}"
                        Severity="{Binding MessageSeverity}"
                        IsOpen="{Binding IsInfoBarVisible}"
                        IsClosable="True" />
        </Grid>
    </Grid>
</UserControl>
