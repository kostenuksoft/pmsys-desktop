<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:PMS.ViewModels"
             xmlns:models="using:PMS.Core.Models"
             xmlns:converters="clr-namespace:PMS.Core.Extensions.Converters"
             x:Class="PMS.Views.Controls.UserManagementView"
             x:DataType="vm:UserManagementViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <converters:RoleConverter x:Key="RoleConverter" />
        <converters:RoleToBrushConverter x:Key="RoleToBrushConverter" />
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto, Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center">
                <ui:SymbolIcon
                    Symbol="Find"
                    FontSize="25"
                    Margin="10,0"
                    VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Name="SearchBox"
                         Tag="Пошук за логіном, ПІБ або email..."
                         Foreground="Black"
                         MinWidth="500"
                         MaxWidth="500"
                         Text="{Binding UserSearchText}"
                         Margin="0,10,0,12" />
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">

                <StackPanel Spacing="4">
                    <TextBlock Text="Роль користувача"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="180"
                              SelectedIndex="0"
                              SelectionChanged="OnRoleFilterChanged">
                        <ComboBoxItem Content="Всі ролі" Tag="" />
                        <ComboBoxItem Content="Адміністратор" Tag="Administrator" />
                        <ComboBoxItem Content="Оператор" Tag="Operator" />
                        <ComboBoxItem Content="Авторизований" Tag="Authorized" />
                        <ComboBoxItem Content="Гість" Tag="Guest" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Статус"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="130"
                              SelectedIndex="0"
                              SelectionChanged="OnStatusFilterChanged">
                        <ComboBoxItem Content="Всі" Tag="" />
                        <ComboBoxItem Content="Активні" Tag="true" />
                        <ComboBoxItem Content="Неактивні" Tag="false" />
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto">

            <ui:CommandBar DefaultLabelPosition="Right"
                           Margin="8">
                <ui:CommandBar.PrimaryCommands>
                    <ui:CommandBarButton
                        Label="Додати користувача"
                        Command="{Binding AddUserCommand}"
                        IconSource="Add" />

                    <ui:CommandBarButton
                        Label="Редагувати"
                        Command="{Binding EditUserCommand}"
                        CommandParameter="{Binding SelectedUser}"
                        IconSource="Edit"
                        IsEnabled="{Binding SelectedUser, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <ui:CommandBarButton
                        Label="Видалити"
                        Command="{Binding DeleteUserCommand}"
                        CommandParameter="{Binding SelectedUser}"
                        IconSource="Delete"
                        IsEnabled="{Binding SelectedUser, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <ui:CommandBarSeparator />

                    <ui:CommandBarButton
                        Label="Оновити"
                        Command="{Binding RefreshCommand}"
                        IconSource="Refresh" />

                    <ui:CommandBarSeparator />

                    <ui:CommandBarButton
                        Label="Заявки гостей"
                        Command="{Binding ViewRequestsCommand}">
                        <ui:CommandBarButton.IconSource>
                            <ui:SymbolIconSource Symbol="Mail" />
                        </ui:CommandBarButton.IconSource>
                        <ui:CommandBarButton>
                            <ui:InfoBadge Value="{Binding GuestRequestsCount}"
                                          IsVisible="{Binding HasNewRequests}" />
                        </ui:CommandBarButton>
                    </ui:CommandBarButton>
                </ui:CommandBar.PrimaryCommands>
            </ui:CommandBar>

            <Button Grid.Column="1"
                    Command="{Binding ClearFiltersCommand}"
                    VerticalAlignment="Center"
                    Classes="WButton"
                    Margin="0,8,8,8"
                    ToolTip.Tip="Очистити всі фільтри">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Clear" FontSize="14" />
                    <TextBlock Text="Очистити фільтри" FontSize="12" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Margin="0,8,25,8">
                <Button Command="{Binding PrevPageCommand}"
                        Padding="8,5"
                        MinWidth="32"
                        ToolTip.Tip="Попередня сторінка">
                    <ui:SymbolIcon Symbol="ChevronLeft" FontSize="12" />
                </Button>

                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="10,5"
                        MinWidth="60"
                        VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               HorizontalAlignment="Center">
                        <Run Text="{Binding CurrentPage}" FontWeight="SemiBold" />
                        <Run Text="/" />
                        <Run Text="{Binding TotalPages}" />
                    </TextBlock>
                </Border>

                <Button Command="{Binding NextPageCommand}"
                        Padding="8,5"
                        MinWidth="32"
                        ToolTip.Tip="Наступна сторінка">
                    <ui:SymbolIcon Symbol="ChevronRight" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Margin="8,0,8,8"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    CornerRadius="4"
                    ClipToBounds="True">
                <DataGrid Name="UsersDataGrid"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Логін"
                                            Binding="{Binding Login}"
                                            Width="Auto"
                                            MinWidth="120" />

                        <DataGridTextColumn Header="ПІБ"
                                            Binding="{Binding FullName}"
                                            Width="Auto"
                                            MinWidth="200" />

                        <DataGridTextColumn Header="Email"
                                            Binding="{Binding Email}"
                                            Width="Auto"
                                            MinWidth="180" />

                        <DataGridTemplateColumn Header="Роль"
                                                Width="Auto"
                                                MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:User">
                                    <Border Padding="6,4"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Background="{Binding Role, Converter={StaticResource RoleToBrushConverter}}">
                                        <TextBlock Text="{Binding Role, Converter={StaticResource RoleConverter}}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Статус"
                                                Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="models:User">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Останній вхід"
                                            Binding="{Binding LastLogin, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                            Width="Auto"
                                            MinWidth="140" />

                    </DataGrid.Columns>

                   
                    <DataGrid.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="Редагувати"
                                      Command="{Binding EditUserCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Edit" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Блокувати"
                                      Command="{Binding LockAccountCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="BlockContact" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Розблокувати"
                                      Command="{Binding UnlockAccountCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Contact" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Скинути пароль"
                                      Command="{Binding ResetPasswordCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Refresh" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Видалити"
                                      Command="{Binding DeleteUserCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </DataGrid.ContextFlyout>

                </DataGrid>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                CornerRadius="4"
                Padding="12,8"
                Margin="8,0,8,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="Admin" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="Всього:" />
                            <Run Text="{Binding TotalUsers}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <Border Width="1" Height="16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="Accept" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="Активних:" />
                            <Run Text="{Binding ActiveUsers}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <Border Width="1" Height="16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            IsVisible="{Binding HasNewRequests}" />
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasNewRequests}">
                        <ui:SymbolIcon Symbol="Mail" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="Нових заявок:" />
                            <Run Text="{Binding GuestRequestsCount}" FontWeight="SemiBold" Foreground="#FF6B00" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding IsBusy}"
                            VerticalAlignment="Center">
                    <ui:ProgressRing Width="16"
                                     Height="16"
                                     IsIndeterminate="True" />
                    <TextBlock Text="{Binding BusyMessage}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="8,0,8,8">
            <ui:InfoBar Title="{Binding Title}"
                        Message="{Binding Message}"
                        Severity="{Binding MessageSeverity}"
                        IsOpen="{Binding IsInfoBarVisible}"
                        IsClosable="True" />
        </Grid>

    </Grid>

</UserControl>