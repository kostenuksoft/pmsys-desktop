<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:PMS.ViewModels"
             xmlns:general="clr-namespace:PMS.Core.Enums.General"
             x:Class="PMS.Views.Controls.RoomsView"
             x:DataType="vm:RoomViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto, Auto">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto" HorizontalAlignment="Center">
                <ui:SymbolIcon
                    Symbol="Find"
                    FontSize="25"
                    Margin="10, 0"
                    VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Tag="Пошук за номером кабінету або типом..."
                         Foreground="Black"
                         MinWidth="500"
                         MaxWidth="500"
                         Text="{Binding SearchText}"
                         Margin="0,10,0,12">
                </TextBox>
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">

                <StackPanel Spacing="4">
                    <TextBlock Text="Тип кабінету" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="220"
                              SelectedValue="{Binding FilterRoomType}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Всі типи" Tag="{x:Null}" />
                        <ComboBoxItem Content="Кабінет лікаря">
                            <ComboBoxItem.Tag>
                                <general:RoomType>DoctorOffice</general:RoomType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Процедурний кабінет">
                            <ComboBoxItem.Tag>
                                <general:RoomType>Procedure</general:RoomType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Фізіотерапія">
                            <ComboBoxItem.Tag>
                                <general:RoomType>PhysicalTherapy</general:RoomType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="УЗД">
                            <ComboBoxItem.Tag>
                                <general:RoomType>Ultrasound</general:RoomType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Лабораторія">
                            <ComboBoxItem.Tag>
                                <general:RoomType>Laboratory</general:RoomType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Реєстратура">
                            <ComboBoxItem.Tag>
                                <general:RoomType>Reception</general:RoomType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Адміністративний">
                            <ComboBoxItem.Tag>
                                <general:RoomType>Administrative</general:RoomType>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Статус" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="130"
                              SelectedValue="{Binding FilterIsActive}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Всі" Tag="{x:Null}" />
                        <ComboBoxItem Content="Активні">
                            <ComboBoxItem.Tag>
                                <x:Boolean>True</x:Boolean>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="Неактивні">
                            <ComboBoxItem.Tag>
                                <x:Boolean>False</x:Boolean>
                            </ComboBoxItem.Tag>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto">

            <ui:CommandBar DefaultLabelPosition="Right"
                           Margin="8">
                <ui:CommandBar.PrimaryCommands>
                    <ui:CommandBarButton
                        Label="Новий кабінет"
                        Command="{Binding AddRoomCommand}"
                        IconSource="Add" />

                    <ui:CommandBarButton 
                        Label="Редагувати"
                        Command="{Binding EditRoomCommand}"
                        CommandParameter="{Binding SelectedRoom}"
                        IconSource="Edit"
                        IsEnabled="{Binding SelectedRoom, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <ui:CommandBarButton 
                        Label="Видалити"
                        Command="{Binding DeleteRoomCommand}"
                        CommandParameter="{Binding SelectedRoom}"
                        IconSource="Delete"
                        IsEnabled="{Binding SelectedRoom, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <ui:CommandBarSeparator />
                    <ui:CommandBarButton
                        Label="Оновити"
                        Command="{Binding RefreshCommand}"
                        IconSource="Refresh" />
                </ui:CommandBar.PrimaryCommands>
            </ui:CommandBar>

            <Button Grid.Column="1"
                    Command="{Binding ClearFiltersCommand}"
                    VerticalAlignment="Center"
                    Classes="WButton"
                    Margin="0,8,8,8"
                    ToolTip.Tip="Очистити всі фільтри">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Clear" FontSize="14" />
                    <TextBlock Text="Очистити фільтри" FontSize="12" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Margin="0,8,25,8">
                
                <Button Command="{Binding FirstPageCommand}"
                        Padding="8,5"
                        Classes="W"
                        MinWidth="32"
                        IsVisible="False"
                        ToolTip.Tip="Перша сторінка">
                    <ui:SymbolIcon Symbol="Previous" FontSize="12" />
                </Button>

                <Button Command="{Binding PreviousPageCommand}"
                        Padding="8,5"
                        MinWidth="32"

                        ToolTip.Tip="Попередня сторінка">
                    <ui:SymbolIcon Symbol="ChevronLeft" FontSize="12" />
                </Button>

                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="10,5"
                        MinWidth="60"
                        VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               HorizontalAlignment="Center">
                        <Run Text="{Binding CurrentPage}" FontWeight="SemiBold" />
                        <Run Text="/" />
                        <Run Text="{Binding TotalPages}" />
                    </TextBlock>
                </Border>

                <Button Command="{Binding NextPageCommand}"
                        Padding="8,5"
                        MinWidth="32"
                        ToolTip.Tip="Наступна сторінка">
                    <ui:SymbolIcon Symbol="ChevronRight" FontSize="12" />
                </Button>

                <Button Command="{Binding LastPageCommand}"
                        Padding="8,5"
                        MinWidth="32"
                        IsVisible="False"
                        ToolTip.Tip="Остання сторінка">

                    <ui:SymbolIcon Symbol="Next" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="8,0,8,8">

            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    CornerRadius="4"
                    ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Rooms}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          SelectionMode="Extended"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectedItem="{Binding SelectedRoom}">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Номер кабінету"
                                            Binding="{Binding RoomNumber}"
                                            Width="Auto"
                                            MinWidth="120" />

                        <DataGridTextColumn Header="Тип кабінету"
                                            Binding="{Binding RoomTypeDisplay}"
                                            Width="Auto"
                                            MinWidth="200" />

                        <DataGridTextColumn Header="Поверх"
                                            Binding="{Binding Floor}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Місткість"
                                            Binding="{Binding Capacity}"
                                            Width="Auto" />

                        <DataGridTextColumn Header="Обладнання"
                                            Binding="{Binding EquipmentDisplay}"
                                            Width="Auto"
                                            MinWidth="200" />

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding StatusDisplay}"
                                            Width="Auto" />

                    </DataGrid.Columns>

                    <DataGrid.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="Редагувати"
                                      Command="{Binding EditRoomCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Edit" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Видалити"
                                      Command="{Binding DeleteRoomCommand}"
                                      CommandParameter="{Binding $parent[DataGrid].SelectedItem}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </DataGrid.ContextFlyout>

                </DataGrid>
            </Border>

        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                CornerRadius="4"
                Padding="12,8"
                Margin="8,0,8,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="Home" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="Всього кабінетів:" />
                            <Run Text="{Binding TotalItems}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <Border Width="1" Height="16"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:SymbolIcon Symbol="Accept" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="На сторінці:" />
                            <Run Text="{Binding Rooms.Count}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding IsBusy}"
                            VerticalAlignment="Center">
                    <ui:ProgressRing Width="16"
                                     Foreground="DarkSlateGray"
                                     Height="16"
                                     IsIndeterminate="True" />
                    <TextBlock Text="{Binding BusyMessage}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="8,0,8,8">
            <ui:InfoBar Title="{Binding Title}"
                        Message="{Binding Message}"
                        Severity="{Binding MessageSeverity}"
                        IsOpen="{Binding IsInfoBarVisible}"
                        IsClosable="True" />
        </Grid>
    </Grid>
</UserControl>
