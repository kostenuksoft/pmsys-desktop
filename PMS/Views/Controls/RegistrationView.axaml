<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:vm="clr-namespace:PMS.ViewModels"
             mc:Ignorable="d" 
             d:DesignWidth="600" 
             x:Class="PMS.Views.Controls.RegistrationView"
             x:CompileBindings="True"
             x:DataType="vm:RegistrationViewModel">

	<UserControl.Styles>
		<Style Selector="TextBox">
			<Setter Property="Height" Value="42"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<Style Selector="TextBlock.section-title">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Foreground" Value="#2F4F4F"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<Style Selector="Border.form-section">
			<Setter Property="Background" Value="#FAFCFC"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Margin" Value="0,0,0,16"/>
		</Style>
	</UserControl.Styles>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Border Background="#FFFFFF"
                CornerRadius="12"
                BoxShadow="0 4 24 0 #20000000"
                Margin="30"
                MaxWidth="650"
                HorizontalAlignment="Center">

			<Grid RowDefinitions="Auto,*,Auto">
				
				<!-- Header Section -->
				<Border Grid.Row="0" 
                        CornerRadius="12,12,0,0"
                        Padding="40,30">
					<StackPanel Orientation="Vertical">
						<StackPanel Orientation="Horizontal" Spacing="15">
							<Viewbox Width="48" Height="48">
								<controls:IconSourceElement IconSource="AddFriend"/>
							</Viewbox>

							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="{Binding Header.Value}"
                                          FontWeight="SemiBold"
                                          FontSize="24"
                                          Foreground="#2F4F4F"/>

								<TextBlock Text="{Binding Subtitle.Value}"
                                          FontSize="13"
                                          Foreground="#5F9EA0"
                                          Margin="0,4,0,0"/>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Form Content -->
				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="40,30,40,20" Spacing="0">
						
						<!-- Required Fields Section -->
						<Border Classes="form-section">
							<StackPanel Spacing="14">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<controls:SymbolIcon Symbol="Important"
                                                        FontSize="16"
                                                        Foreground="#5F9EA0"/>
									<TextBlock Classes="section-title"
                                              Text="{Binding SectionRequired.Value}"
                                              Margin="0"/>
								</StackPanel>

								<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,16,*">
									<!-- Login - Full Width -->
									<TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                            Text="{Binding Login}"
                                            Tag="{Binding LoginTag.Value}"
                                            Margin="0,0,0,12"/>

									<!-- Email - Full Width -->
									<TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                            Text="{Binding Email}"
                                            Tag="{Binding EmailTag.Value}"
                                            Margin="0,0,0,12"/>

									<!-- Full Name - Full Width -->
									<TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                            Text="{Binding FullName}"
                                            Tag="{Binding FullNameTag.Value}"
                                            Margin="0,0,0,12"/>

									<!-- Password - Left Column -->
									<TextBox Grid.Row="3" Grid.Column="0"
                                            Text="{Binding Password}"
                                            PasswordChar="•"
                                            Tag="{Binding PasswordTag.Value}"
                                            Margin="0,0,0,0"/>

									<!-- Confirm Password - Right Column -->
									<TextBox Grid.Row="3" Grid.Column="2"
                                            Text="{Binding ConfirmPassword}"
                                            PasswordChar="•"
                                            Tag="{Binding ConfirmPasswordTag.Value}"
                                            Margin="0,0,0,0"/>
								</Grid>

						
							</StackPanel>
						</Border>

						<!-- Additional Information Section -->
						<Border Classes="form-section">
							<StackPanel Spacing="14">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<controls:SymbolIcon Symbol="ContactInfo"
                                                        FontSize="16"
                                                        Foreground="#5F9EA0"/>
									<TextBlock Classes="section-title"
                                              Text="{Binding SectionAdditional.Value}"
                                              Margin="0"/>
								</StackPanel>

								<TextBox Text="{Binding MobilePhone}"
                                        Tag="{Binding MobilePhoneTag.Value}"/>

								<Grid RowDefinitions="Auto" ColumnDefinitions="*,16,*">
									<TextBox Grid.Column="0"
                                            Text="{Binding Organization}"
                                            Tag="{Binding OrganizationTag.Value}"/>

									<TextBox Grid.Column="2"
                                            Text="{Binding Position}"
                                            Tag="{Binding PositionTag.Value}"/>
								</Grid>
							</StackPanel>
						</Border>

						<!-- Purpose Section -->
						<Border Classes="form-section">
							<StackPanel Spacing="14">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<controls:SymbolIcon Symbol="Message"
                                                        FontSize="16"
                                                        Foreground="#5F9EA0"/>
									<TextBlock Classes="section-title"
                                              Text="{Binding SectionPurpose.Value}"
                                              Margin="0"/>
								</StackPanel>

								<TextBox Text="{Binding Message}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="110"
                                        MaxHeight="180"
                                        Tag="{Binding MessageTag.Value}"
                                        VerticalContentAlignment="Top"
                                        Padding="11,10"/>

								<TextBlock Text="{Binding MessageHint.Value}"
                                          FontSize="11"
                                          Foreground="#999999"/>
							</StackPanel>
						</Border>

					</StackPanel>
				</ScrollViewer>

				<!-- Footer with Action Buttons -->
				<Border Grid.Row="2" 
                        CornerRadius="0,0,12,12"
                        Padding="40,20,40,30"
                        BorderBrush="#E8F4F4"
                        BorderThickness="0,1,0,0">
					<Grid ColumnDefinitions="*,Auto">
						
						<!-- Info Text -->
						<StackPanel Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0, 0, 20, 0">
							<TextBlock Text="{Binding FooterCheckData.Value}"
                                      FontSize="12"
                                      FontWeight="Medium"
                                      Foreground="#2F4F4F"/>
							<TextBlock Text="{Binding FooterReview.Value}"
                                      FontSize="11"
                                      Foreground="#999999"/>
						</StackPanel>

						<StackPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   Spacing="5"
                                   HorizontalAlignment="Right">

							<Button Command="{Binding ClearFormCommand}"
                                   Classes="WButton"
                                   MinWidth="40">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<controls:SymbolIcon Symbol="Clear" FontSize="16"/>
									<TextBlock Text="{Binding ClearButton.Value}" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

							<Button Command="{Binding SubmitRequestCommand}"
                                   Classes="WButton accent"
                                   MinWidth="40">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<controls:SymbolIcon Symbol="Send" FontSize="16"/>
									<TextBlock Text="{Binding SubmitButton.Value}" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Grid>
				</Border>

				<!-- Loading Overlay -->
				<Border Grid.Row="0"
                       Grid.RowSpan="3"
                       Background="#E6FFFFFF"
                       CornerRadius="12"
                       IsVisible="False">
					<StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Spacing="16">
						<controls:ProgressRing IsActive="True"
                                              Width="56"
                                              Height="56"/>
						<TextBlock Text="{Binding LoadingText.Value}"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  Foreground="#2F4F4F"
                                  HorizontalAlignment="Center"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</ScrollViewer>
</UserControl>
